# Copy to .env.local and fill in. Never commit real secrets.

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.travelstation.world

# Optional overrides for contact details (defaults live in src/config/contact.ts)
# NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY="+1 (833) 595-1923"
# NEXT_PUBLIC_SUPPORT_PHONE_TEL=+18335951923
# NEXT_PUBLIC_SUPPORT_EMAIL=customercare@travelstation.world

# --- Database (REQUIRED in production) ----------------------------------------
# Enquiries are stored in MongoDB. Without this, production returns 503 for
# enquiry submissions. In development only, enquiries fall back to .data/enquiries.jsonl.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/travelstation

# --- Email notifications (SMTP / transactional provider) ----------------------
# If SMTP_* are not set, enquiries are still saved but no email is sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TravelStation <no-reply@travelstation.world>"
# Where staff notifications go (defaults to the support email in config/contact.ts)
ENQUIRY_NOTIFY_TO=customercare@travelstation.world
# Send the customer an acknowledgement email (default true)
SEND_CUSTOMER_CONFIRMATION=true

# --- Anti-spam ----------------------------------------------------------------
# Salt for the one-way IP hash stored with each enquiry. Set to a long random string.
IP_HASH_SALT=change-me
